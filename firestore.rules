rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.role == 'SUPER_ADMIN' || request.auth.token.role == 'ADMIN');
    }

    function isCommittee() {
      return isAuthenticated() &&
        (isAdmin() || request.auth.token.role == 'SCIENTIFIC_COMMITTEE');
    }

    // ---------- Paramètres d'édition ----------
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- Participants ----------
    // Inscription publique sans compte : création avec statut REGISTERED uniquement.
    // L'admin confirme (CONFIRMED) et pointe la présence (ATTENDED).
    match /participants/{participantId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.applicationStatus != 'CONFIRMED'
                    && request.resource.data.attendance == 'NOT_CHECKED';
      allow update, delete: if isAdmin();
    }

    // ---------- Candidatures ----------
    // Dépôt public : statut initial SUBMITTED, jamais challenger auto.
    match /candidates/{candidateId} {
      allow read: if isCommittee();
      allow create: if request.resource.data.applicationStatus == 'SUBMITTED'
                    && request.resource.data.isChallenger == false;
      allow update, delete: if isAdmin();
    }

    // ---------- Demandes de sponsoring ----------
    match /sponsorshipRequests/{sponsorId} {
      allow read: if true; // sponsors approuvés visibles publiquement
      allow create: if request.resource.data.status == 'PENDING';
      allow update, delete: if isAdmin();
    }

    // ---------- Membres de l'organisation ----------
    // Jamais auto-attribués : écriture réservée aux admins.
    match /organizations/{orgId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- Votes anti-fraude ----------
    // Registre : un document par hash d'e-mail — création unique, immuable.
    match /votes/{voteId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.verified == true;
      allow update, delete: if false;
    }

    // ---------- Évaluations (comité privé) ----------
    match /evaluations/{candidateId} {
      allow read: if isCommittee();
      allow create, update: if isCommittee() &&
        (!resource.data.isLocked || isAdmin());
      allow delete: if isAdmin();
    }

    // ---------- Badges ----------
    match /badges/{badgeId} {
      allow read: if true; // vérification publique par token
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- Attestations ----------
    match /certificates/{certId} {
      allow read: if true; // vérification publique d'authenticité
      allow write: if isAdmin();
    }

    // ---------- Journal d'audit ----------
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // immuable
    }

    // ---------- Journal d'e-mails ----------
    match /emailLogs/{logId} {
      allow read: if isAdmin();
      allow create: if true; // log des confirmations
      allow update, delete: if false;
    }

    // ---------- Programme, FAQ, distinctions ----------
    match /program/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /faq/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /awards/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- Utilisateurs admin ----------
    match /users/{userId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
